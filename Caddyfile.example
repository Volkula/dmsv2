{
	auto_https off
}

(shirmo) {
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

:80 {
	import shirmo
}

# HTTPS: подставьте свой домен и пути к сертификатам, сохраните как Caddyfile.
:443 {
	tls /etc/letsencrypt/live/example.com/fullchain.pem /etc/letsencrypt/live/example.com/privkey.pem
	import shirmo
}
